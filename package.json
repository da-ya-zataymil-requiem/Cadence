{
  "name": "cadence",
  "productName": "Cadence",
  "version": "0.1.0",
  "description": "Cadence desktop music player",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.cadence.desktop",
    "productName": "Cadence",
    "artifactName": "${productName}.${ext}",
    "files": [
      "main.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "da-ya-zataymil-requiem",
      "repo": "Cadence"
    }
  }
}
